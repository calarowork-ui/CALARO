# Backend configuration for Calaro (development / docker-compose)
# Copy to backend/.env and fill in your secrets. Never commit backend/.env.

PROJECT_NAME=Calaro AI
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# MongoDB. Local: install MongoDB Community or run `docker run -d -p 27017:27017 mongo:7`.
# Atlas works too: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Docker Compose overrides this with the bundled mongo service.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=calaro

# The only super-admin. It can create, list and revoke admins.
# Set SUPERADMIN_PASSWORD in backend/.env. It is used once, when the account is first created.
# Left empty, a one-time password is generated and printed in the backend logs.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Bhashini (Vaani voice logging in 12 Indian languages) ---
# bhashini.gov.in dashboard -> your app ("calaro") -> click the eye icon, copy both keys
BHASHINI_INFERENCE_API_KEY=
BHASHINI_UDYAT_KEY=
# Only for older ULCA accounts that show "User ID" + "ULCA API key" instead:
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
BHASHINI_TTS_GENDER=female
BHASHINI_TTS_SAMPLING_RATE=22050

# --- Optional local LLM fallback for foods not in the Indian food DB ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:latest
WHISPER_MODEL=base
