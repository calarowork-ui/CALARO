# Copy to .env (next to docker-compose.yml). Used by Docker Compose itself.

# Your computer:
SITE_ADDRESS=http://localhost
PUBLIC_URL=http://localhost

# On the server, use instead:
# SITE_ADDRESS=calaro.online
# PUBLIC_URL=https://calaro.online

# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=you@example.com
SUPERADMIN_EMAIL=calaro@admin.calaro.com
MONGO_EXPRESS_PASSWORD=change-me
